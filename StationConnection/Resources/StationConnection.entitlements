<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Permiso de CarPlay para apps de audio. Solo tiene efecto al firmar con
	     una cuenta de pago de Apple Developer que Apple haya autorizado.
	     Ver docs/adr/0009-carplay.md -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
</dict>
</plist>
